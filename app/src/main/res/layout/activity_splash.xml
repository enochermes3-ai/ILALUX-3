<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/splash_bg">
    <FrameLayout android:id="@+id/logoBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="44dp" android:layout_marginEnd="44dp">
        <ImageView android:id="@+id/logoMain"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter"
            android:src="@drawable/logo_main"
            android:contentDescription="Logo Observatorio Ilalux" />
        <ImageView android:id="@+id/logoStars"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter"
            android:src="@drawable/logo_stars"
            android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
