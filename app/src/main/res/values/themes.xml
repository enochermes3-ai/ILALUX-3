<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ilalux" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="colorPrimary">@color/azul</item>
    </style>
    <style name="Theme.Ilalux.Splash" parent="Theme.Ilalux">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#D3E4FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
